# ============================================================================
# KUTUBUKU — Environment Variables (.env.example)
# Copy this file to `.env` and fill in your values
# ============================================================================

# In Supabase Dashboard: Project Settings -> Database -> Connection string -> URI
# Use the "Transaction Pooler" (port 6543) for Vercel Serverless compatibility.
# If left empty or omitted, the app automatically falls back to in-memory mock data!
DATABASE_URL=""

# Secret used to sign session cookies (generate any random 32+ char string)
AUTH_SECRET=""

# Google OAuth (for "Continue with Google" fast-track onboarding)
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5173/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
